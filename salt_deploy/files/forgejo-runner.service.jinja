[Unit]
Description=Forgejo Actions runner for Salt deployments
Documentation=https://forgejo.org/docs/latest/admin/actions/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ runner.user }}
Group={{ runner.group }}
WorkingDirectory={{ runner.home }}
ExecStart={{ forgejo.binary }} daemon -c {{ forgejo.config_file }}
Restart=always
RestartSec=5s

# Workflow scratch space is kept out of the system /tmp. This is the only
# filesystem confinement the unit sets, and that is deliberate.
PrivateTmp=true

# There is no ProtectSystem= here on purpose. The job this runner exists to
# run is `sudo {{ deploy.script }}`, and a sudo'd process stays inside the
# unit's mount namespace: any path made read-only here is read-only for the
# deployment too. With ProtectSystem=strict the checkout, the fileserver
# cache and every post-deployment state that writes to /etc or installs a
# package all fail - as permission errors that look like anything but a
# sandbox. Confinement that has to be switched off to let the service work
# is worse than none, because the next person reads it and believes it.
#
# The boundary that does hold is the one the sudoers rule draws: this account
# is unprivileged and may run exactly one root command, whose behaviour is
# baked in at render time and cannot be steered by the workflow. That is what
# keeps a compromised workflow from becoming a compromised master, and it is
# not weakened by anything above.
#
# If you do want the deployment confined, confine the deployment rather than
# the runner: have the sudo'd script hand the work to a transient unit with
# systemd-run, which leaves this namespace behind. That needs its own review
# of what post_deploy states touch, so it is not the default.

[Install]
WantedBy=multi-user.target
